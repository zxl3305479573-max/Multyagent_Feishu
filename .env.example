# Project manager bot (fill this first)
FEISHU_PROJECT_MANAGER_APP_ID=
FEISHU_PROJECT_MANAGER_APP_SECRET=

# Optional: restrict events to this project chat ID.
FEISHU_ALLOWED_CHAT_ID=

# Pi Agent model provider.
# DeepSeek uses the official API-compatible provider in pi-coding-agent.
PI_AGENT_PROVIDER=deepseek
PI_AGENT_MODEL=deepseek-chat
PI_AGENT_THINKING=off
DEEPSEEK_API_KEY=

# Optional: override the diagram-design skill directory used by the
# architect and project-manager agents. Defaults to ~/.codex/skills/diagram-design.
PI_DIAGRAM_SKILL_PATH=

# Add these as each role bot is created.
FEISHU_ARCHITECT_APP_ID=
FEISHU_ARCHITECT_APP_SECRET=
FEISHU_FRONTEND_DEVELOPER_APP_ID=
FEISHU_FRONTEND_DEVELOPER_APP_SECRET=
FEISHU_BACKEND_DEVELOPER_APP_ID=
FEISHU_BACKEND_DEVELOPER_APP_SECRET=
FEISHU_TESTER_APP_ID=
FEISHU_TESTER_APP_SECRET=
FEISHU_AUDITOR_APP_ID=
FEISHU_AUDITOR_APP_SECRET=

# Optional: multi-dimensional table (Bitable) task board.
# The project-manager app needs the bitable:app scope and must be added as an
# editor of the table. Role bots do not need any Bitable permission.
#
# FEISHU_BITABLE_WIKI_TOKEN is the token in a /wiki/<token>?table=... URL.
# The gateway resolves it to the real Bitable app token at startup.
FEISHU_BITABLE_WIKI_TOKEN=
# Or skip Wiki resolution and paste the app token from a /base/<token> URL.
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# Optional: separate table for structured execution Trace. Only the project-
# manager app uses this table; local JSONL tracing works without it.
FEISHU_BITABLE_TRACE_TABLE_ID=
# Additive-only: create the board fields when they are missing. Set to false to
# make the gateway report missing fields instead of creating them.
FEISHU_BITABLE_AUTO_INIT=true
# Poll interval for the one-shot 控制指令 field.
FEISHU_BITABLE_CONTROL_POLL_MS=5000
# Scratch file that maps task_id -> Bitable record_id.
FEISHU_BITABLE_RECORDS_FILE=runtime/bitable-records.json
# Scratch file that maps event_id -> Trace record_id.
FEISHU_BITABLE_TRACE_RECORDS_FILE=runtime/bitable-trace-records.json
