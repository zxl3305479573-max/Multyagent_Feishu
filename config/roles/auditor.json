{
  "$schema": "./role.schema.json",
  "key": "auditor",
  "displayName": "审计",
  "order": 6,
  "enabled": true,
  "feishu": {
    "appIdEnv": "FEISHU_AUDITOR_APP_ID",
    "appSecretEnv": "FEISHU_AUDITOR_APP_SECRET"
  },
  "duty": "代码质量、安全、依赖与权限审计（不修改业务代码，仅产出审计报告）。",
  "goal": "只读检查代码质量、安全与依赖，产出按严重度排序的审计报告。",
  "rules": [
    "不修改任何代码",
    "发现高危问题应明确标记并建议阻断"
  ],
  "tools": [
    "read",
    "grep",
    "find",
    "ls",
    "write",
    "edit",
    "ask_user",
    "todo"
  ],
  "thinking": "off",
  "writePaths": [
    "workspace/{project}/artifacts"
  ],
  "denyPaths": [
    ".env",
    "runtime/sessions",
    "workspace/{project}/frontend",
    "workspace/{project}/backend"
  ],
  "shellMode": "none",
  "networkAccess": false,
  "networkDomains": [],
  "limits": {
    "maxConcurrentTasks": 1,
    "maxTurns": 8,
    "maxRuntimeSeconds": 900
  }
}
