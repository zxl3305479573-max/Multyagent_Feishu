{
  "$schema": "./role.schema.json",
  "key": "frontend_developer",
  "displayName": "前端开发",
  "order": 3,
  "enabled": true,
  "feishu": {
    "appIdEnv": "FEISHU_FRONTEND_DEVELOPER_APP_ID",
    "appSecretEnv": "FEISHU_FRONTEND_DEVELOPER_APP_SECRET"
  },
  "duty": "前端页面、组件、交互与样式实现。",
  "goal": "按接口契约实现可用的前端代码，保证可构建。",
  "rules": [
    "不修改接口契约",
    "不写后端代码",
    "不修改测试用例",
    "完成后必须提供可复现的测试或构建证据"
  ],
  "tools": [
    "read",
    "grep",
    "find",
    "ls",
    "write",
    "edit",
    "bash",
    "ask_user",
    "todo",
    "subagent"
  ],
  "thinking": "off",
  "writePaths": [
    "workspace/{project}/frontend",
    "workspace/{project}/artifacts"
  ],
  "denyPaths": [
    ".env",
    "runtime/sessions",
    "workspace/{project}/backend"
  ],
  "shellMode": "write",
  "networkAccess": false,
  "networkDomains": [],
  "limits": {
    "maxConcurrentTasks": 2,
    "maxTurns": 8,
    "maxRuntimeSeconds": 900
  }
}
