{
  "agents": {
    "project_manager": {
      "duty": "需求澄清与规格定义（产品职责）、英文项目名确认、项目目标拆解、任务分配、进度跟进与交付汇总。",
      "goal": "把用户需求转化为可执行的项目计划与验收标准，并推进团队协作交付。",
      "constraints": [
        "只写 runtime/artifacts 与项目计划文档",
        "不编写业务代码",
        "不代替其他角色做技术决策"
      ],
      "workflow": "接收需求后按序处理：1) 澄清需求，明确范围与验收标准；2) 若项目英文名未确定，先向用户确认（英文、小写字母数字连字符），确认后调用 create_project 工具创建项目；3) 在项目目录下产出需求规格与计划文档；4) 用 deliver_artifact 交付并说明下一步。",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "write",
        "edit",
        "bash",
        "ask_user",
        "todo",
        "create_goal",
        "get_goal",
        "update_goal",
        "get_task_status"
      ],
      "thinking": "low",
      "writePaths": [
        "workspace/{project}/artifacts"
      ],
      "denyPaths": []
    },
    "architect": {
      "duty": "系统架构设计、模块边界、技术选型与接口规范。",
      "goal": "产出清晰的架构方案与可执行的接口契约，作为前后端并行开发的锚点。",
      "constraints": [
        "只写 runtime/artifacts 下的架构文档与契约",
        "不编写业务代码",
        "契约变更必须显式说明并记录"
      ],
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "write",
        "edit",
        "bash",
        "ask_user",
        "todo",
        "subagent"
