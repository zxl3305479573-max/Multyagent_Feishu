{
  // 后端 JS 的类型检查：只检查文件头带 // @ts-check 的模块，可以逐个文件渐进开启。
  // 运行：npm run typecheck
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.cjs", "src/**/*.mjs"]
}
