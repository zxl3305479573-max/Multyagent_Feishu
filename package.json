{
  "name": "multyagent-feishu-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "基于项目隔离与结构化执行轨迹的多 Agent 桌面工作台",
  "author": "MultyAgent",
  "main": "desktop/electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop": "electron desktop/electron/main.cjs",
    "desktop:portable": "npm run desktop:build && electron-builder --win dir",
    "desktop:package": "npm run desktop:build && electron-builder --win",
    "data:merge": "node scripts/merge-data-dir.mjs",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p desktop/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "agent:cli": "node scripts/agent-cli.mjs",
    "worktree": "node scripts/worktree.mjs",
    "bitable:check": "node scripts/check-bitable.mjs",
    "bitable:setup": "node scripts/setup-bitable-board.mjs",
    "bitable:smoke": "node scripts/smoke-bitable.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@larksuiteoapi/node-sdk": "^1.50.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^16.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typebox": "^1.3.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
